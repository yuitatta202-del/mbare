generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

model Profile {
  id                        String                      @id @db.Uuid
  username                  String?                     @unique
  firstName                 String?                     @map("first_name")
  lastName                  String?                     @map("last_name")
  avatarUrl                 String?                     @map("avatar_url")
  role                      String                      @default("USER")
  isActive                  Boolean                     @default(true) @map("is_active")
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  matricola                 String?                     @unique
  university                String?
  dipartimento              String?
  corsoDiStudi              String?                     @map("corso_di_studi")
  annoCorso                 Int?                        @map("anno_corso")
  bio                       String?
  cercaCoinquilino          Boolean?                    @default(false) @map("cerca_coinquilino")
  interessi                 String[]                    @default([])
  email                     String?                     @unique
  sport                     String?
  lavoro                    String?
  palio                     String?
  palioRuolo                String?                     @map("palio_ruolo")
  conversation_participants conversation_participants[]
  audit_logs                audit_logs[]
  boardPosts                BoardPost[]
  comments                  Comment[]
  consents                  consents[]
  eventParts                EventParticipant[]
  events                    Event[]
  groupMembers              GroupMember[]
  sentMessages              Message[]
  moderationActions         ModerationAction[]          @relation("ModeratorActions")
  notifications             notifications[]
  postLikes                 PostLike[]
  post_views                post_views[]
  posts                     Post[]
  users                     users                       @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reports                   Report[]
  resolvedReports           Report[]                    @relation("ResolvedBy")
  saved_board_posts         saved_board_posts[]
  spiffera                  Spiffera[]                  @relation("AuthorSpiffera")
  moderatedSpiffera         Spiffera[]                  @relation("ModeratorSpiffera")
  spifferaVotes             SpifferaVote[]
  studyGroups               StudyGroup[]
  tokenTransactions         TokenTransaction[]
  wallet                    Wallet?

  @@index([username], map: "idx_profiles_username")
  @@map("profiles")
  @@schema("public")
}

model Category {
  id          BigInt   @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  scope       String   @default("POST")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  posts       Post[]

  @@map("categories")
  @@schema("public")
}

model Post {
  id            BigInt       @id @default(autoincrement())
  title         String
  slug          String       @unique
  content       String
  excerpt       String?
  status        String       @default("draft")
  categoryId    BigInt?      @map("category_id")
  tags          String[]     @default([])
  featuredImage String?      @map("featured_image")
  viewCount     Int          @default(0) @map("view_count")
  authorId      String?      @map("author_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  comments      Comment[]
  likes         PostLike[]
  post_views    post_views[]
  author        Profile?     @relation(fields: [authorId], references: [id], onUpdate: NoAction)
  category      Category?    @relation(fields: [categoryId], references: [id], onUpdate: NoAction)

  @@index([categoryId], map: "idx_posts_category")
  @@index([status], map: "idx_posts_status")
  @@index([status, createdAt(sort: Desc)], map: "idx_posts_status_created")
  @@index([status, createdAt(sort: Desc)], map: "idx_posts_status_date")
  @@map("posts")
  @@schema("public")
}

model Spiffera {
  id          String            @id(map: "confessions_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content     String
  category    spiffera_category
  isAnonymous Boolean           @default(true) @map("is_anonymous")
  authorId    String?           @map("author_id") @db.Uuid
  status      String            @default("pending")
  score       Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  approvedAt  DateTime?         @map("approved_at") @db.Timestamptz(6)
  moderatedBy String?           @map("moderated_by") @db.Uuid
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)
  spicyLevel  Int?              @default(50) @map("spicy_level")
  comments    Comment[]
  author      Profile?          @relation("AuthorSpiffera", fields: [authorId], references: [id], onUpdate: NoAction)
  moderator   Profile?          @relation("ModeratorSpiffera", fields: [moderatedBy], references: [id], onUpdate: NoAction)
  votes       SpifferaVote[]

  @@index([category], map: "idx_confessions_category")
  @@index([status, createdAt(sort: Desc)], map: "idx_confessions_status_created")
  @@index([status, score(sort: Desc)], map: "idx_confessions_status_score")
  @@index([status, createdAt(sort: Desc)], map: "idx_spiffera_status_created")
  @@index([status, createdAt(sort: Desc)], map: "idx_spiffera_status_date")
  @@map("spiffera")
  @@schema("public")
}

model SpifferaVote {
  id         BigInt   @id(map: "confession_votes_pkey") @default(autoincrement())
  spifferaId String   @map("spiffera_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  value      Int      @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  spiffera   Spiffera @relation(fields: [spifferaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([spifferaId, userId], map: "unique_user_spiffera_vote")
  @@unique([spifferaId, userId], map: "confession_votes_confession_id_user_id_key")
  @@unique([spifferaId, userId], map: "unique_user_confession_vote")
  @@index([spifferaId], map: "idx_spiffera_votes_spiffera")
  @@map("spiffera_votes")
  @@schema("public")
}

model Comment {
  id         BigInt    @id @default(autoincrement())
  postId     BigInt?   @map("post_id")
  spifferaId String?   @map("spiffera_id") @db.Uuid
  parentId   BigInt?   @map("parent_id")
  content    String
  authorId   String?   @map("author_id") @db.Uuid
  authorName String?   @map("author_name")
  status     String    @default("pending")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  author     Profile?  @relation(fields: [authorId], references: [id], onUpdate: NoAction)
  parent     Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replies    Comment[] @relation("CommentToComment")
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  spiffera   Spiffera? @relation(fields: [spifferaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([spifferaId], map: "idx_comments_confession")
  @@index([parentId], map: "idx_comments_parent_id")
  @@index([postId], map: "idx_comments_post")
  @@index([postId], map: "idx_comments_post_id")
  @@index([spifferaId], map: "idx_comments_spiffera")
  @@index([spifferaId], map: "idx_comments_spiffera_id")
  @@map("comments")
  @@schema("public")
}

model PostLike {
  id        BigInt   @id @default(autoincrement())
  postId    BigInt   @map("post_id")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([postId, userId], map: "unique_user_post_like")
  @@unique([postId, userId])
  @@map("post_likes")
  @@schema("public")
}

model Event {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  category     String
  location     String
  city         String
  eventDate    DateTime           @map("event_date") @db.Timestamptz(6)
  imageUrl     String?            @map("image_url")
  createdBy    String?            @map("created_by") @db.Uuid
  isApproved   Boolean?           @default(false) @map("is_approved")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  participants EventParticipant[]
  creator      Profile?           @relation(fields: [createdBy], references: [id], onUpdate: NoAction)

  @@index([isApproved], map: "idx_events_approved")
  @@index([category], map: "idx_events_category")
  @@index([city], map: "idx_events_city")
  @@index([eventDate], map: "idx_events_date")
  @@index([isApproved, eventDate], map: "idx_events_status_date")
  @@map("events")
  @@schema("public")
}

model EventParticipant {
  id        BigInt   @id @default(autoincrement())
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String?  @default("JOINED")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eventId, userId], map: "unique_user_event")
  @@unique([eventId, userId])
  @@map("event_participants")
  @@schema("public")
}

model StudyGroup {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  category    String
  city        String
  maxMembers  Int?          @default(10) @map("max_members")
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  members     GroupMember[]
  creator     Profile?      @relation(fields: [createdBy], references: [id], onUpdate: NoAction)

  @@map("study_groups")
  @@schema("public")
}

model GroupMember {
  id       BigInt     @id @default(autoincrement())
  groupId  String     @map("group_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  joinedAt DateTime   @default(now()) @map("joined_at") @db.Timestamptz(6)
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     Profile    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([groupId, userId], map: "unique_user_group")
  @@unique([groupId, userId])
  @@map("group_members")
  @@schema("public")
}

model Report {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId String?   @map("reporter_id") @db.Uuid
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  reason     String
  note       String?
  status     String    @default("open")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy String?   @map("resolved_by") @db.Uuid
  reporter   Profile?  @relation(fields: [reporterId], references: [id], onUpdate: NoAction)
  resolver   Profile?  @relation("ResolvedBy", fields: [resolvedBy], references: [id], onUpdate: NoAction)

  @@index([status], map: "idx_reports_status")
  @@map("reports")
  @@schema("public")
}

model ModerationAction {
  id          BigInt   @id @default(autoincrement())
  moderatorId String?  @map("moderator_id") @db.Uuid
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  action      String
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  moderator   Profile? @relation("ModeratorActions", fields: [moderatorId], references: [id], onUpdate: NoAction)

  @@map("moderation_actions")
  @@schema("public")
}

model Conversation {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contextType               String?                     @map("context_type")
  contextId                 String?                     @map("context_id")
  isActive                  Boolean                     @default(true) @map("is_active")
  lastMessageId             String?                     @map("last_message_id") @db.Uuid
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation_participants conversation_participants[]
  messages                  Message[]

  @@map("conversations")
  @@schema("public")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String?      @map("sender_id") @db.Uuid
  content        String
  isRead         Boolean      @default(false) @map("is_read")
  readAt         DateTime?    @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender         Profile?     @relation(fields: [senderId], references: [id], onUpdate: NoAction)

  @@index([conversationId, createdAt(sort: Desc)], map: "idx_messages_conversation_created")
  @@index([conversationId, createdAt], map: "idx_messages_conversation_date")
  @@map("messages")
  @@schema("public")
}

model BoardPost {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  content           String
  category          String
  authorId          String?             @map("author_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  type              String?             @default("OFFRO")
  tags              String[]            @default([])
  price             Float?
  status            String?             @default("active")
  images            String[]            @default([])
  view_count        Int                 @default(0)
  city              String?
  expires_at        DateTime?           @db.Timestamptz(6)
  bumped_at         DateTime?           @default(now()) @db.Timestamptz(6)
  author            Profile?            @relation(fields: [authorId], references: [id], onUpdate: NoAction)
  saved_board_posts saved_board_posts[]

  @@index([authorId], map: "idx_board_posts_author")
  @@index([category, createdAt(sort: Desc)], map: "idx_board_posts_category")
  @@index([category, createdAt(sort: Desc)], map: "idx_board_posts_category_date")
  @@index([type], map: "idx_board_posts_type")
  @@index([bumped_at(sort: Desc)], map: "idx_board_posts_bumped")
  @@index([city], map: "idx_board_posts_city")
  @@index([status], map: "idx_board_posts_status")
  @@map("board_posts")
  @@schema("public")
}

model Wallet {
  userId      String   @id @map("user_id") @db.Uuid
  balance     Int      @default(0)
  totalEarned Int      @default(0) @map("total_earned")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("wallets")
  @@schema("public")
}

model TokenTransaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  amount      Int
  reason      String
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("token_transactions")
  @@schema("public")
}

model conversation_participants {
  conversation_id String       @db.Uuid
  user_id         String       @db.Uuid
  conversations   Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "_conversation_participants_conversation_fkey")
  profiles        Profile      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "_conversation_participants_user_fkey")

  @@id([conversation_id, user_id])
  @@map("_conversation_participants")
  @@schema("public")
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action      String
  entity_id   String?
  entity_type String?
  ip_address  String?
  user_agent  String?
  user_id     String?  @db.Uuid
  metadata    Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  profiles    Profile? @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@schema("public")
}

model consents {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  consent_type String
  is_granted   Boolean
  ip_address   String?
  user_agent   String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  profiles     Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  title      String
  message    String
  type       String?  @default("INFO")
  is_read    Boolean? @default(false)
  link       String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  profiles   Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read], map: "idx_notifications_user")
  @@index([user_id, is_read], map: "idx_notifications_user_unread")
  @@schema("public")
}

model post_views {
  id         BigInt   @id @default(autoincrement())
  post_id    BigInt
  user_id    String?  @db.Uuid
  ip_address String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  posts      Post     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles   Profile? @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([post_id, created_at(sort: Desc)], map: "idx_post_views_post")
  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log_entries {
  instance_id String?   @db.Uuid
  id          String    @id @db.Uuid
  payload     Json?     @db.Json
  created_at  DateTime? @db.Timestamptz(6)
  ip_address  String    @default("") @db.VarChar(64)

  @@index([instance_id], map: "audit_logs_instance_id_idx")
  @@schema("auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
